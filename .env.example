# ── Model provider ──────────────────────────────────────────────────────────────
# openai | anthropic | google | ollama. Agents need one of these to run.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=                      # any OpenAI-compatible endpoint
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=google                   # Gemini; the free tier is enough to try NEXUS
# LLM_MODEL=gemini-3.5-flash-lite       # small and cheap: about 5k tokens for a 3-agent run
GOOGLE_API_KEY=
# LLM_MAX_OUTPUT_TOKENS=4096            # cap on each reply
# LLM_PROVIDER=ollama                   # free and local: docker compose --profile ollama up
# LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2

# ── Embeddings ──────────────────────────────────────────────────────────────────
# local = BAAI/bge-small-en-v1.5 on CPU (no key, ~130 MB download on first use)
# openai = text-embedding-3-small at 384 dimensions (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# ── Security ────────────────────────────────────────────────────────────────────
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32b
COOKIE_SECURE=false

# ── Guards ──────────────────────────────────────────────────────────────────────
RUN_TIMEOUT_SECONDS=600
NODE_TIMEOUT_SECONDS=120
NODE_MAX_ATTEMPTS=3
DEFAULT_MAX_REVISIONS=2
HARD_MAX_REVISIONS=5
RUN_TOKEN_BUDGET=200000
MAX_CONCURRENT_RUNS=4
MAX_UPLOAD_MB=20

# ── Tools ───────────────────────────────────────────────────────────────────────
# Hosts the http_get tool may fetch (JSON list)
HTTP_TOOL_ALLOWLIST=["en.wikipedia.org","api.github.com","raw.githubusercontent.com"]
# Webhooks the send_webhook tool may post to after approval (JSON list). Empty disables the tool.
WEBHOOK_URLS=[]

# ── Local development without Docker (Compose sets these itself) ───────────────
# DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
# RUN_MODE=embedded                    # API + worker + projector in one process
# EVENT_BUS=memory                     # or kafka with KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# REDIS_URL=redis://localhost:6379/0

# ── Vercel (serverless) — see DEPLOY.md ──────────────────────────────────────────
# RUN_MODE=serverless                  # no background loops; commands go to Vercel Queues
# COMMAND_QUEUE=inline                 # run commands in the receiving function (wait_until); "vercel" = Vercel Queues
# UPLOAD_STORAGE=database              # file bytes in Postgres; functions share no disk
# MAX_UPLOAD_MB=4                      # Vercel caps request bodies at 4.5 MB
# RUN_TIMEOUT_SECONDS=270              # stay under the function limit (300 s on Hobby)
# TOKEN_FLUSH_MS=120                   # batch streamed tokens (saves Upstash commands)
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# EMBEDDING_PROVIDER=openai            # or local with MODEL_CACHE_DIR=/tmp/models
# COOKIE_SECURE=true
# ENVIRONMENT=production
# LOG_JSON=true
